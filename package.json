{
  "name": "dsh-context-sniper",
  "version": "0.1.0",
  "description": "Lossless context archival + retrieval for DeepSeek Harness: when the conversation overflows the context window, archive the oldest rounds verbatim (keep the newest N), and let the model search them back.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./select": "./lib/select.js",
    "./archive": "./lib/archive.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/select.js",
    "lib/archive.js",
    "lib/config.js",
    "lib/client.js",
    "lib/client-api.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spicycorn/dsh-context-sniper.git"
  },
  "homepage": "https://github.com/spicycorn/dsh-context-sniper#readme",
  "bugs": {
    "url": "https://github.com/spicycorn/dsh-context-sniper/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "context",
    "archival",
    "retrieval",
    "context-window"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=3.0.0",
    "react": ">=18.0.0"
  },
  "license": "MIT"
}
